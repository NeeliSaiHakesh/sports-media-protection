# Media Guard AI — Environment Variables
# Copy this file to .env and configure as needed

# Backend
PORT=8000
HOST=0.0.0.0

# Database path (relative to backend/)
DB_PATH=data/mediaguard.db

# Upload directory (relative to backend/)
UPLOAD_DIR=uploads

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Maximum upload size in bytes (default 20MB)
MAX_UPLOAD_BYTES=20971520
